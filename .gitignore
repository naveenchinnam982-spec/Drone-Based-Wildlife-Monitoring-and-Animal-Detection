results/*
!results/.gitkeep

# Large temporary models / experimental weights (>100MB exceeds GitHub push limits)
weights/
yolov8s-worldv2.pt
yolo11s.pt

# IDE / Editor
.vscode/
.idea/
*.swp

# Logs and runtime artifacts
*.log
