# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
ENV/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Output / generated runtime folders (keep folder structure, exclude dynamic files)
uploads/*
